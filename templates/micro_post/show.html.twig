{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block bread %} <a href="{{ path('app_micro_post') }}">Posts</a> -> {{ post.title }} {% endblock %}
{% block body %}
    {{ include('micro_post/_post.html.twig', { post: post }) }}

    <div class="mt-4">
        {% for comment in post.comments %}
            {{ include('micro_post/_comment.html.twig', { comment: comment }) }}
        {% else %}
            <div class="text-gray-500 dark:text-gray-400">
                No comments yet
            </div>
        {% endfor %}
    </div>
{% endblock %}