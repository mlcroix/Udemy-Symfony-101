{% extends 'base.html.twig' %}

{% block bread %} 
    {% if page_title == "Edit post" %}
        -> <a href="{{ path('app_micro_post_show', { post: post.id }) }}">{{ post.title }}</a>
    {% else %}
        -> <a href="{{ path('app_micro_post') }}">Posts</a>
    {% endif %}
    {{ bread }} 
{% endblock %}

{% block body %}
    <h1> {{ page_title }} </h1>
    {{ form_start(form) }}
        <div> {{ form_errors(form) }} </div>

        <div>
            {{ form_label(form.title, null, {
                'label_attr': {'class': 'block text-sm text-gray-700 dark:text-gray-300 font-medium'}
                }) 
            }}

            {{ form_widget(form.title, {
                'attr': {'class': 'block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2'}
                }) 
            }}
            {{ form_errors(form.title) }}

            {{ form_label(form.text, null, {
                'label_attr': {'class': 'block text-sm text-gray-700 dark:text-gray-300 font-medium'}
                }) 
            }}

            {{ form_widget(form.text, {
                'attr': {'class': 'block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2'}
                }) 
            }}
            {{ form_errors(form.text) }}
        </div>

        <div>
            <button type="submit" class="block w-full shadow-sm border-trasparent bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white rounded-md border p-2 mt-1 mb-2">
                Save
            </button>
        </div>
    {{ form_end(form) }}
{% endblock %}