{% extends 'base.html.twig' %}

{% block body %}
    <h1> {{ page_title }} </h1>
    {{ form_start(form) }}
        <div> {{ form_errors(form) }} </div>

        <div>
            {{ form_label(form.title) }}
        </div>
        <div>
            {{ form_widget(form.title) }}
        </div>

        <div>
            {{ form_label(form.text) }}
        </div>
        <div>
            {{ form_widget(form.text) }}
        </div>

        <div>
            <button type="submit">Save</button>
    {{ form_end(form) }}
{% endblock %}