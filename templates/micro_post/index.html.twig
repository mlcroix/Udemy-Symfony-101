{% extends 'base.html.twig' %}

{% block title %}All messages{% endblock %}

{% block body %}
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grdid-cols-3 gap-4"> 
        {% if posts|length > 0 %}
                {% for post in posts %}
                    {{ include('micro_post/_post.html.twig', { post: post }) }}
                {% endfor %}
            {% else %}
                <div>
                    <p> Nothing here yet </p>
                </div>
            {% endif %}
    </div>
{% endblock %}
