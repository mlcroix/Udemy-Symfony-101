{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}
{% block bread %}-> Login{% endblock %}

{% block body %}
    <h1>Login</h1>

    <form action="{{ path('app_login') }}" method="post">
        <label for="email" class="block text-sm text-gray-700 dark:text-gray-300 font-medium">Email:</label>
        <input type="email" name="_username" value="{{ lastUsername }}" required class="block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2">

        <label for="password" class="block text-sm text-gray-700 dark:text-gray-300 font-medium">Password:</label>
        <input type="password" name="_password" required class="block w-full shadow-sm border-gray-300 dark:border-transparent dark:text-gray-800 rounded-md border p-2 mt-1 mb-2">

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="bblock w-full shadow-sm border-trasparent bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white rounded-md border p-2 mt-1 mb-2">
            Login
        </button>
    </form>

{% endblock %}
